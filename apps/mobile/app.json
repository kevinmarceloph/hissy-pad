{
  "expo": {
    "name": "HissyPad",
    "slug": "hissy-pad",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ph.marcelo.hissypad",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "INAlternativeAppNames": [
          {
            "INAlternativeAppName": "Hissy Pad"
          }
        ]
      },
      "appleTeamId": "22M56484D3",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.ph.marcelo.hissypad"
        ]
      }
    },
    "android": {
      "package": "ph.marcelo.hissypad",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f7f4ec"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-web-browser",
      "./plugins/withNoShakeToEdit",
      "@bacons/apple-targets",
      "./plugins/withNativeSources"
    ],
    "scheme": "hissypad",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f4ec"
    },
    "extra": {
      "eas": {
        "projectId": "be5fcc66-3f5c-4331-8ba9-ffd9aa663355"
      }
    },
    "owner": "kevinmarceloph",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/be5fcc66-3f5c-4331-8ba9-ffd9aa663355"
    }
  }
}
