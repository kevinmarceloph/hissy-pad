{
  "name": "@hissypad/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Screens shared by apps/web and apps/mobile, written in React Native: the Hours mode (Oras-oras inside HissyPad). The web app draws them through react-native-web.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./palette": "./src/hours/palette.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hissypad/core": "workspace:*",
    "@hissypad/state": "workspace:*",
    "zustand": "^5"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/react": "~19.3.0",
    "@vitejs/plugin-react": "^6",
    "jsdom": "^29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "~0.21.4",
    "typescript": "^6",
    "vitest": "^5"
  }
}
